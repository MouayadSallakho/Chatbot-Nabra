<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OmniAI.Application\OmniAI.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AssemblyReferenceReader.cs" Link="AssemblyReferenceReader.cs" />
    <!-- Deterministic clock for the use cases that supply an effective instant. -->
    <Compile Include="..\Shared\FixedTimeProvider.cs" Link="FixedTimeProvider.cs" />
    <!-- Deterministic AI text generator, so no test needs a provider or a network. -->
    <Compile Include="..\Shared\RecordingAiTextGenerator.cs" Link="RecordingAiTextGenerator.cs" />
    <Compile Include="..\Shared\RecordingUsageLedger.cs" Link="RecordingUsageLedger.cs" />
    <Compile Include="..\Shared\FakeEntitlements.cs" Link="FakeEntitlements.cs" />

    <!--
      A payment provider that answers from memory, so that not one test in this
      repository opens a socket to a payment company, holds a real key, or has a
      card entered into it.
    -->
    <Compile Include="..\Shared\FakeBillingProvider.cs" Link="FakeBillingProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
