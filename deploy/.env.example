# OmniAI production environment -- EXAMPLE ONLY. Copy to deploy/.env (never
# committed) or, better, inject these from your secret store.
#
# Every value below is a placeholder. Generate real secrets on the host, e.g.
#   openssl rand -base64 32        (OMNIAI_SECRET_MASTER_KEY: exactly 32 bytes)
#   openssl rand -base64 48        (passwords, PUBLIC_CHAT_NETWORK_KEY_SECRET)
# and write them straight into the file -- never paste them into a terminal
# history, a ticket or a chat.
#
# The master key encrypts the Data Protection key ring and every stored channel
# credential. Losing it logs everybody out and makes stored WhatsApp tokens
# unreadable; leaking it exposes them. Back it up separately from the database.

# ---- images --------------------------------------------------------------
OMNIAI_API_IMAGE=omniai-api:CHANGE_ME_VERSION
OMNIAI_MIGRATOR_IMAGE=omniai-migrator:CHANGE_ME_VERSION
OMNIAI_EDGE_IMAGE=omniai-edge:CHANGE_ME_VERSION

# ---- edge / TLS ------------------------------------------------------------
# Directory holding tls.crt (full chain) and tls.key, mounted read-only.
OMNIAI_TLS_DIR=/etc/omniai/tls
# Production: bind 0.0.0.0, publish 80/443 and leave the suffix empty.
OMNIAI_EDGE_BIND=0.0.0.0
OMNIAI_EDGE_HTTP_PORT=80
OMNIAI_EDGE_HTTPS_PORT=443
OMNIAI_PUBLIC_HTTPS_PORT_SUFFIX=
# The public origin, used for billing return URLs and email links.
OMNIAI_PUBLIC_BASE_URL=https://app.example.com

# ---- PostgreSQL --------------------------------------------------------------
OMNIAI_DB=omniai
OMNIAI_PG_SUPERUSER_PASSWORD=CHANGE_ME
OMNIAI_OWNER_PASSWORD=CHANGE_ME
OMNIAI_APP_PASSWORD=CHANGE_ME
OMNIAI_PG_MAX_CONNECTIONS=100
# The runtime role's connection allowance: max_connections minus the superuser
# reserve (3) minus room for the migrator, backups and an operator (7).
# The API refuses to start unless 2 instances x (app + lock + 2) fit in it.
OMNIAI_DB_BUDGET_CONNECTIONS=90
OMNIAI_DB_APP_POOL=25
OMNIAI_DB_LOCK_POOL=15

# ---- Redis -----------------------------------------------------------------
OMNIAI_REDIS_PASSWORD=CHANGE_ME

# ---- application secrets -------------------------------------------------------
OMNIAI_SECRET_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
PUBLIC_CHAT_NETWORK_KEY_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS

# The plan new workspaces start on. Must be a finite plan ("free" or "starter");
# never "development", which is unlimited.
OMNIAI_DEFAULT_PLAN_CODE=free

# ---- optional integrations ------------------------------------------------
# Provider credentials (OpenAI, Stripe, WhatsApp, SMTP) are NOT set here: they
# live in deploy/providers.env (template: providers.env.example), which the API
# reads literally. Keeping them out of compose interpolation means a key that
# happens to exist in the deploying shell can never switch live traffic on.
OMNIAI_BILLING_FALLBACK_PLAN_CODE=free
# OMNIAI_PROVIDERS_FILE=./providers.env
