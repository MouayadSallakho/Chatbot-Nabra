<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Api is the composition root: hosting, HTTP surface and dependency wiring.
    Business rules must not live here.
  -->
  <!--
    The hubs and the realtime notifier are internal: nothing outside this
    assembly should be able to name a hub type, and making one public to the
    whole solution would invite exactly that. The API integration suite is the
    exception, because proving the Redis backplane actually carries an
    announcement between two instances means constructing both instances.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="OmniAI.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="SkiaSharp" />
    <!-- Redis backplane for SignalR, so realtime survives a second instance. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniAI.Application\OmniAI.Application.csproj" />
    <ProjectReference Include="..\OmniAI.Infrastructure\OmniAI.Infrastructure.csproj" />
  </ItemGroup>


  <!--
    The widget loader, compiled into the assembly and served by
    WidgetLoaderEndpoints. An embedded resource rather than a file under a static
    root: this application has no static-file middleware, and serving a directory
    would mean serving whatever ends up in it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Widget\v1.js" LogicalName="OmniAI.Api.Widget.v1.js" />
  </ItemGroup>

</Project>
