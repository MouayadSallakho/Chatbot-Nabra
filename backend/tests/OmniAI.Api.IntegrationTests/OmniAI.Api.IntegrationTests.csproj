<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- Hosts the real API in memory so HTTP behaviour is exercised end to end. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OmniAI.Api\OmniAI.Api.csproj" />
  </ItemGroup>

  <!--
    Same disposable-PostgreSQL provisioning as the Infrastructure suite. Compiled
    in from Shared rather than reimplemented, so both suites migrate and drop
    databases the same way.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\PostgresTestDatabase.cs" Link="PostgresTestDatabase.cs" />
    <!--
      Deterministic clock. Used by one dedicated fixture that substitutes it for
      TimeProvider.System, so exact timestamps and the high-water-mark rule can be
      proven over real HTTP. Every other API fixture runs the real clock.
    -->
    <Compile Include="..\Shared\FixedTimeProvider.cs" Link="FixedTimeProvider.cs" />
    <!--
      Deterministic AI text generator. Installed by one dedicated fixture in place
      of the unconfigured production implementation, so the preview slice can be
      proven end to end without a provider, an API key or a network call.
    -->
    <Compile Include="..\Shared\RecordingAiTextGenerator.cs" Link="RecordingAiTextGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
