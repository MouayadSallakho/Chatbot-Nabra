<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure implements Application-owned abstractions. It references
    Domain only where a persisted/mapped domain type is legitimately required.
    Every database dependency stops here: neither Domain nor Application may
    reference EF Core or Npgsql.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!--
      ASP.NET Core Identity's EF Core stores. This project is where credentials
      are persisted, so this is where the package belongs: neither Domain nor
      Application references it, and guard tests assert that. The API consumes
      Identity's services through the shared framework rather than through here.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!--
      The official OpenAI SDK. It appears in this project and nowhere else: the
      Application owns IAiTextGenerator, and the vendor stops at the adapter that
      implements it.
    -->
    <PackageReference Include="OpenAI" />
    <!--
      The Redis client behind the public-chat protection counters. Like the
      OpenAI SDK above, it appears in this project and nowhere else: the
      Application owns IPublicChatProtection and asks whether a public request
      may proceed, and this is the only assembly that knows the answer is a Lua
      script against Redis.
    -->
    <PackageReference Include="StackExchange.Redis" />
    <!--
      IHttpClientFactory for the WhatsApp Cloud API adapter. Like the OpenAI SDK
      and the Redis client above, the vendor's transport stops in this project.
    -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!--
      The file parsers behind Knowledge uploads. Like every other vendor
      dependency, they stop in this project: the Application asks for text out of
      bytes and never names a library.
    -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Unicode.Bidi" />
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The repository implementation stays internal: nothing outside this project
    should name it, only the Application contract it satisfies. Its own tests are
    the exception, so they are granted access explicitly rather than by making
    the type public to the whole solution.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="OmniAI.Infrastructure.IntegrationTests" />
    <!--
      The API integration suite installs the real OpenAI adapter over a canned
      socket, so it needs the internal client factory. Granted explicitly rather
      than by making the adapter public: nothing outside these two test projects
      should be able to name it.
    -->
    <InternalsVisibleTo Include="OmniAI.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniAI.Application\OmniAI.Application.csproj" />
    <ProjectReference Include="..\OmniAI.Domain\OmniAI.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Label="Report fonts">
    <!--
      The brand's fonts (Phase 39.7b): Geist 1.900 (Regular, SemiBold) for Latin
      text and every digit, IBM Plex Sans Arabic 1.005 (Regular, SemiBold) for
      Arabic, both the upstream TTF releases under the SIL Open Font License.
      DejaVu Sans stays only as the last resort for scripts neither brand font
      draws (Greek, Cyrillic, Hebrew and the like). All bundled so a PDF renders
      identically on every host: nothing is read from the operating system's
      fonts and nothing is fetched. Embedded in the assembly rather than copied
      beside it, so no file path is involved at run time. Each licence travels
      with its fonts, as it requires.
    -->
    <EmbeddedResource Include="Reports\Rendering\Fonts\Geist\Geist-Regular.ttf" LogicalName="OmniAI.Reports.Fonts.Geist-Regular.ttf" />
    <EmbeddedResource Include="Reports\Rendering\Fonts\Geist\Geist-SemiBold.ttf" LogicalName="OmniAI.Reports.Fonts.Geist-SemiBold.ttf" />
    <None Include="Reports\Rendering\Fonts\Geist\OFL.txt" Link="Reports\Rendering\Fonts\OFL-Geist.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Reports\Rendering\Fonts\IBMPlexSansArabic\IBMPlexSansArabic-Regular.ttf" LogicalName="OmniAI.Reports.Fonts.IBMPlexSansArabic-Regular.ttf" />
    <EmbeddedResource Include="Reports\Rendering\Fonts\IBMPlexSansArabic\IBMPlexSansArabic-SemiBold.ttf" LogicalName="OmniAI.Reports.Fonts.IBMPlexSansArabic-SemiBold.ttf" />
    <None Include="Reports\Rendering\Fonts\IBMPlexSansArabic\OFL.txt" Link="Reports\Rendering\Fonts\OFL-IBMPlexSansArabic.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Reports\Rendering\Fonts\DejaVuSans.ttf" LogicalName="OmniAI.Reports.Fonts.DejaVuSans.ttf" />
    <EmbeddedResource Include="Reports\Rendering\Fonts\DejaVuSans-Bold.ttf" LogicalName="OmniAI.Reports.Fonts.DejaVuSans-Bold.ttf" />
    <None Include="Reports\Rendering\Fonts\LICENSE-DejaVu.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
