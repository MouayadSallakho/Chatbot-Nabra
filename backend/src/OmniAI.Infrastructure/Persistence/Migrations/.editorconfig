# EF Core generated migration code.
#
# Scoped to this folder only. Everything hand-written elsewhere in the solution
# keeps both rules enforced. These files are emitted by `dotnet ef migrations
# add` and are regenerated by the tool, so holding them to our own formatting
# conventions would mean re-editing generated output after every migration for
# no correctness benefit.

[*.cs]
# The scaffolder emits block-scoped namespaces.
dotnet_diagnostic.IDE0161.severity = none

# The scaffolder emits inline `new[] { "a", "b" }` for composite index columns.
dotnet_diagnostic.CA1861.severity = none
