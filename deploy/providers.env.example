# OmniAI optional provider credentials -- EXAMPLE ONLY. Copy to
# deploy/providers.env (never committed) or point OMNIAI_PROVIDERS_FILE at a file
# your secret store renders. Read by the API containers through `env_file`, so
# values here are passed literally and can NOT be overridden by, or leak in
# from, the shell that runs docker compose.
#
# Leave a line empty (or remove the file) to keep that integration off: the
# feature then refuses truthfully and the rest of the product works.

# OpenAI (AI replies and knowledge embeddings). Setting this enables live,
# billed provider traffic.
OPENAI_API_KEY=

# Stripe (subscriptions). Both, or neither.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Cloud API webhooks. Both, or neither.
OMNIAI_WHATSAPP_APP_SECRET=
OMNIAI_WHATSAPP_VERIFY_TOKEN=

# Operational email (SMTP relay). Host empty = email off.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=
