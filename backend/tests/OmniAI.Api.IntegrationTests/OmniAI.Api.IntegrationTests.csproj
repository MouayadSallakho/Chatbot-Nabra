<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!--
      Test-only. Needed to build the canned transport that the OpenAI preview
      suite installs in place of a socket, so that the real adapter and the real
      SDK serialisation run end to end without a network. The production
      OmniAI.Api assembly references no provider SDK, and a guard test asserts it.
    -->
    <PackageReference Include="OpenAI" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- Hosts the real API in memory so HTTP behaviour is exercised end to end. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />

    <!--
      Stripe's own library, used only to GENERATE the signatures these tests send.
      Verifying with one implementation and signing with another would test the
      test's idea of the scheme rather than the scheme. Nothing here calls Stripe.
    -->
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OmniAI.Api\OmniAI.Api.csproj" />
  </ItemGroup>

  <!--
    Same disposable-PostgreSQL provisioning as the Infrastructure suite. Compiled
    in from Shared rather than reimplemented, so both suites migrate and drop
    databases the same way.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\PostgresTestDatabase.cs" Link="PostgresTestDatabase.cs" />
    <!--
      The throwaway Redis both suites measure the public chat protection against.
      Shared for the same reason the PostgreSQL harness is: a second copy of
      "find a server, namespace the keys, clean up" drifts until the two suites
      are testing different things.
    -->
    <Compile Include="..\Shared\RedisTestServer.cs" Link="RedisTestServer.cs" />
    <!-- Reads assembly metadata without loading code, for the layer guards. -->
    <Compile Include="..\Shared\AssemblyReferenceReader.cs" Link="AssemblyReferenceReader.cs" />
    <!--
      Deterministic clock. Used by one dedicated fixture that substitutes it for
      TimeProvider.System, so exact timestamps and the high-water-mark rule can be
      proven over real HTTP. Every other API fixture runs the real clock.
    -->
    <Compile Include="..\Shared\FixedTimeProvider.cs" Link="FixedTimeProvider.cs" />
    <!--
      Deterministic AI text generator. Installed by one dedicated fixture in place
      of the unconfigured production implementation, so the preview slice can be
      proven end to end without a provider, an API key or a network call.
    -->
    <Compile Include="..\Shared\RecordingAiTextGenerator.cs" Link="RecordingAiTextGenerator.cs" />
    <Compile Include="..\Shared\RecordingUsageLedger.cs" Link="RecordingUsageLedger.cs" />
    <Compile Include="..\Shared\FakeEntitlements.cs" Link="FakeEntitlements.cs" />

    <!--
      A payment provider that answers from memory, so that not one test in this
      repository opens a socket to a payment company, holds a real key, or has a
      card entered into it.
    -->
    <Compile Include="..\Shared\FakeBillingProvider.cs" Link="FakeBillingProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
