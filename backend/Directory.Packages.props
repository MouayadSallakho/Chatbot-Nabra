<Project>

  <!--
    Central Package Management: every NuGet version for the backend solution is
    declared here exactly once. Project files reference packages without versions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core">
    <!-- OpenAPI document generation for the HTTP surface consumed by the Angular admin app. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- PostgreSQL provider for EF Core. Infrastructure only; never referenced by Domain or Application. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time only: required by `dotnet ef migrations`. Not shipped at runtime. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!--
      Pinned so every project sees one EF Core version. The provider and the
      design-time package resolve different patches on their own, which made the
      Infrastructure assembly compile against a newer EF Core than its own test
      project could load. Transitive pinning settles it in one place.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Identity">
    <!--
      ASP.NET Core Identity's Entity Framework stores. Infrastructure only: it is
      persistence for credentials, and it is the only package in this file that
      knows what a password hash is.

      Pinned to 10.0.11, the same patch as every EF Core package above, because
      it depends on EF Core itself. A different patch here would reintroduce
      exactly the split-version problem the transitive pinning note describes.

      The rest of what authentication needs (cookie handling, antiforgery, the
      authorization pipeline, the UserManager and SignInManager types) is part
      of the ASP.NET Core shared framework and needs no package reference.
      Nothing here brings a JWT library, an identity server or an external
      provider SDK; none is used.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="AI providers">
    <!--
      Official OpenAI .NET SDK. Infrastructure only: neither Domain, Application
      nor Api references it, so the vendor stops at the adapter that implements
      IAiTextGenerator. 2.13.0 was the latest stable release on nuget.org when
      this phase ran.
    -->
    <PackageVersion Include="OpenAI" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup Label="Public-chat protection">
    <!--
      Redis client for the distributed counters that protect the public chat
      surface. Infrastructure only: the Application asks whether a public request
      may proceed, and nothing above the adapter knows the answer comes from
      Redis. An executable guard asserts the reference never reaches Application,
      Domain or Api.

      3.1.31 was the latest stable release on nuget.org when this phase ran.
      StackExchange.Redis is the mature, maintained client for .NET and the one
      the ecosystem standardises on; nothing here needs a second Redis library,
      an ORM over Redis, or a distributed-cache abstraction.
    -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!--
      In-memory IConfiguration for tests that must prove both branches of the AI
      runtime registration without mutating the process environment. Already in
      the dependency graph transitively; declared here so the test project can
      reference it explicitly rather than rely on another package's graph.
    -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- In-memory ASP.NET Core host used by the API integration test project. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

</Project>
