<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- In-memory configuration, for proving both AI runtime registration branches. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="xunit" />

    <!--
      Stripe's own library, used only to GENERATE the signatures these tests
      verify. Nothing in this suite contacts Stripe.
    -->
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OmniAI.Infrastructure\OmniAI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AssemblyReferenceReader.cs" Link="AssemblyReferenceReader.cs" />
    <Compile Include="..\Shared\PostgresTestDatabase.cs" Link="PostgresTestDatabase.cs" />
    <!--
      The throwaway Redis both suites measure the public chat protection against.
      Shared for the same reason the PostgreSQL harness is: a second copy of
      "find a server, namespace the keys, clean up" drifts until the two suites
      are testing different things.
    -->
    <Compile Include="..\Shared\RedisTestServer.cs" Link="RedisTestServer.cs" />
    <!-- Deterministic clock, for the storage-precision clock wrapper tests. -->
    <Compile Include="..\Shared\FixedTimeProvider.cs" Link="FixedTimeProvider.cs" />
    <Compile Include="..\Shared\RecordingUsageLedger.cs" Link="RecordingUsageLedger.cs" />
    <Compile Include="..\Shared\FakeEntitlements.cs" Link="FakeEntitlements.cs" />

    <!--
      A payment provider that answers from memory, so that not one test in this
      repository opens a socket to a payment company, holds a real key, or has a
      card entered into it.
    -->
    <Compile Include="..\Shared\FakeBillingProvider.cs" Link="FakeBillingProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
